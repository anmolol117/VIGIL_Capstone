# Copy to .env and fill in the two <ANGLE-BRACKET> values. .env holds secrets —
# do not commit or share it.
#
# The project, table and storage bucket already exist:
#   project  anmolol117's Project  (grknwhtsoginetxkmeto, ap-northeast-2)
#   table    public.speeding_events   — RLS on, no policies
#   bucket   speeding                 — public read
#
# The two values below are secrets that cannot be read programmatically, so you
# have to paste them once yourself.

# 1. Supabase dashboard -> Settings -> Database -> Connection string ->
#    "Session pooler". Replace <YOUR-DB-PASSWORD> with the database password you
#    set when creating the project. (Forgot it? Same page has "Reset database
#    password".)
#
#    Use the SESSION POOLER host below, not db.<ref>.supabase.co — the direct
#    host is IPv6-only on the free tier and fails to resolve on most home
#    networks. Note the pool is aws-1-, not aws-0-: newer projects are on the
#    aws-1 pools and aws-0 returns 'tenant/user not found'. Copy the exact
#    string from the dashboard if in doubt.
DATABASE_URL=postgresql://postgres.grknwhtsoginetxkmeto:<YOUR-DB-PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 2. Already correct — no change needed.
SUPABASE_URL=https://grknwhtsoginetxkmeto.supabase.co

# 3. Supabase dashboard -> Settings -> API Keys -> "Secret keys" section ->
#    the `default` key starting sb_secret_ (click the eye icon to reveal).
#
#    Supabase renamed these: the old `service_role` key is now called a "Secret
#    key" (sb_secret_...), and the old `anon` key is now a "Publishable key"
#    (sb_publishable_...). Either the new secret key or the legacy service_role
#    key works. Do NOT use the publishable key — it is public by design and
#    cannot write to storage.
#
#    Needed to upload evidence frames. It bypasses row-level security, so keep
#    it out of anything public.
SUPABASE_SERVICE_KEY=<YOUR-SECRET-KEY-sb_secret_...>
