#pragma once

// Copy this file to secrets.h and fill in real values. secrets.h is gitignored.
//
// Generate a key with:   openssl rand -hex 32
// The SAME key must go in gateway/.env as PSK_DATA. The receiver never sees it.

// 32 bytes = AES-256.
static const uint8_t PSK_DATA[32] = {
  0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
  0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
  0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f
};

// Unique per transmitter. Use 1 for the entry gate, 2 for exit, etc.
// Part of the GCM nonce, so two units MUST NOT share an ID.
#define DEVICE_ID 1u
