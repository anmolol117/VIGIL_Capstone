# Copy to .env and fill in. .env is gitignored.

# Must be byte-identical to PSK_DATA in transmitter/secrets.h.
# Generate with: openssl rand -hex 32
PSK_DATA=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

SUPABASE_URL=https://grknwhtsoginetxkmeto.supabase.co

# service_role key, NOT the anon key. RLS is on with no policies, so anon can
# read and write nothing. Find it under Project Settings -> API Keys.
SUPABASE_SERVICE_KEY=

# macOS: ls /dev/cu.usbserial-* or /dev/cu.wchusbserial-*
SERIAL_PORT=/dev/cu.usbserial-0001
